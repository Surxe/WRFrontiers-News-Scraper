    "title": "Jump In And Play For Free This Weekend!",
    "summary": "Enter the fray for a limited time",
    "url": "https://warrobotsfrontiers.com/en/news/43-jump-in-and-play-for-free-this-weekend",
    "preview_image": "https://static-eu.prod-my.games/chronos-public-eu-wrf-prod/site/2023/3/43/1150x645.png",

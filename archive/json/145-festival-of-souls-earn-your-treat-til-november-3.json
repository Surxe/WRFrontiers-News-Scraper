    "summary": "Feast on fun.",
    "url": "https://warrobotsfrontiers.com/en/news/145-festival-of-souls-earn-your-treat-til-november-3",
    "preview_image": "https://static-eu.prod-my.games/chronos-public-eu-wrf-prod/site/2024/11/145-FestivalofSouls/news_assets_1150x645.png",

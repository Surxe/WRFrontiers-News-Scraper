    "title": "Wandering Star: Festive Fun From December 5–January 15!",
    "summary": "Shine on this holiday season.",
    "url": "https://warrobotsfrontiers.com/en/news/154-wandering-star-event",
    "preview_image": "https://static-eu.prod-my.games/chronos-public-eu-wrf-prod/site/2024/12/154-WinterEvent/Website_News_1150x645.png",

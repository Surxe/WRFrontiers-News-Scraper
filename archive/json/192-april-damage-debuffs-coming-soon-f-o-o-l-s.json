    "title": "New Feature: Damage Debuffs Coming Soon!",
    "summary": "Advanced Performance Revamp Is Launching!",
    "url": "https://warrobotsfrontiers.com/en/news/192-april-damage-debuffs-coming-soon-f-o-o-l-s",
    "preview_image": "https://static-eu.prod-my.games/chronos-public-eu-wrf-prod/site/2025/04/192-F.O.O.L.S/preview_image.webp",
